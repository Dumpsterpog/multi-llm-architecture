{
  "name": "multi-llm-architecture",
  "version": "0.1.0",
  "description": "Multi-LLM orchestration platform: several models (Claude, GPT, Gemini) collaborate and return one answer.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "create-key": "tsx scripts/create-api-key.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^5.4.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
