rules_version = '2';

// Security rules for the multi-LLM service's collections ("llm_...").
//
// HOW IT WORKS
// The API server uses the Firebase ADMIN SDK, which ignores these rules.
// Browsers use the CLIENT SDK, which obeys them. Browsers must never read or
// write the llm_ collections directly: all chat data, usage and billing go
// through the API, which checks login, limits and ownership itself.
//
// Firestore denies anything that no rule allows, so you get that protection
// simply by NOT writing any rule that matches llm_ collections.
//
// IF THIS PROJECT ALREADY HAS RULES (e.g. the FORKSAI app):
// do not deploy this file over them. Just check your existing rules for a
// broad catch-all such as
//     match /{document=**} { allow read, write: if request.auth != null; }
// Rules are OR-ed, so a catch-all like that WOULD expose llm_ data to any
// signed-in user. If you have one, narrow it like this:
//     match /{collection}/{document=**} {
//       allow read, write: if request.auth != null && !collection.matches('llm_.*');
//     }
//
// IF THIS IS A NEW PROJECT used only by this service, deploy this file as is:
// it locks the whole database to the server.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
