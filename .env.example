# ---------------------------------------------------------------------------
# Copy this file to .env and fill in what you need.
# Every value is validated at boot by src/config/env.ts, so a typo fails fast
# instead of failing on the first user request.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Storage ---------------------------------------------------------------
# "memory" runs with zero setup (great for local dev; lost on restart).
# Production: STORE=firestore and KV=firestore (or KV=redis when you grow).
STORE=memory
KV=memory
# Only for KV=redis, e.g. a free Upstash database: rediss://default:<pw>@<host>:6379
REDIS_URL=

# --- Firebase (same variables as the FORKSAI app) ----------------------------
# Leave empty on Google Cloud Run: the machine's service account is used.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Collections are named llm_users, llm_conversations... so they can share a
# Firebase project with another app without clashing.
FIRESTORE_COLLECTION_PREFIX=llm_

# --- Provider keys ---------------------------------------------------------
# A provider is only enabled when its key is present. Leave blank to disable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# The mock provider returns canned answers without calling any vendor.
# It lets you exercise the whole pipeline (limits, billing, debate) for free.
ENABLE_MOCK_PROVIDER=true

# --- Dev bootstrap ---------------------------------------------------------
# Only used by the in-memory store: an API key that exists at boot so you can
# call the API immediately. Never set this in production.
DEV_API_KEY=mlk_dev_change_me
DEV_API_KEY_PLAN=pro

# --- Tuning ----------------------------------------------------------------
PROVIDER_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=2
CACHE_TTL_SECONDS=3600

# --- Website ---------------------------------------------------------------
# Origins of your chat website allowed to call this API from the browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Website logins are Firebase ID tokens, verified automatically when Firebase
# is configured. This secret is a DEV-ONLY shortcut: POST /v1/auth/dev-token
# issues test tokens so you can try things without signing in. Ignored in production.
AUTH_JWT_SECRET=dev-secret-change-me-to-32-plus-random-chars

# --- Cost protection for you -------------------------------------------------
# Max the WHOLE platform may spend on AI vendors per day (USD, our cost).
# When hit, new chats get a "busy, try later" message instead of a big bill.
PLATFORM_DAILY_BUDGET_USD=25
# Per-IP request rate (stops one person farming many free accounts).
IP_REQUESTS_PER_MINUTE=30
